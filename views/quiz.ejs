<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>BPSC Quiz <%= year %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
  /*===============================
    Light / Dark Mode Color Variables
  ===============================*/
  :root {
    --bg-color:    #f8f9fa;
    --text-color:  #212529;
    --card-bg:     #ffffff;
    --btn-bg:      #007bff;
    --btn-text:    #ffffff;
    --filter-bg:   #eef4fb;
    --option-bg:    #f1f1f1;
  --option-text:  #212529;
  --option-hover: #e2e6ea;
   --close-color: #333;
   --mode-bg: #eef4fb;
  --mode-text: #0056b3;
    /* Progress bar colors for Light Mode */
   --progress-bg:   #e0f7f1;
  --progress-fill: #00b894;   /* strong teal */
  --progress-text: #00695c;
  }

  /* Base page styling */
  body {
    background-color: var(--bg-color);
    color: var(--text-color);
    margin: 0;
  }

  /* Dark mode overrides */
  body.dark-mode {
    --bg-color:  #181a1b;
    --text-color:#e8e6e3;
    --card-bg:   #242526;
    --btn-bg:    #3a3b3c;
    --btn-text:  #e8e6e3;
    --filter-bg: #242526;
     --option-bg:    #3a3b3c;
  --option-text:  #e8e6e3;
  --option-hover: #4e4f50;
    --close-color: #e8e6e3;
    --mode-bg: #2e2e2e;
  --mode-text: #88c0d0;
  /* Progress bar colors for Dark Mode */
 --progress-bg:   #1f2e2e;
  --progress-fill: #55efc4;   /* neon mint */
  --progress-text: #dfe6e9;
  }
/* Apply to your container and fill */
#progressBar {
  background: var(--progress-bg);
}

#progressFill {
  background: var(--progress-fill) !important;
}

#progressText {
  color: var(--progress-text) !important;
}

/* Optional: add a subtle border/ring around the bar */
#progressBar {
  border: 1px solid rgba(0,0,0,0.1);
  border-radius: 4px;
}

/* On very small screens, shrink its height a bit */
@media (max-width: 400px) {
  #progressBar {
    height: 6px;
  }
}

  /* Container & typography */
  .app-container {
    font-family: 'Segoe UI', sans-serif;
    margin: 0 auto;
    margin-left: 10%;
    padding: 20px;
    max-width: 800px;
  }
  h1 {
    text-align: center;
    color: var(--text-color);
  }

  /* Hot‑spot selectors for theming */
  .question-box,
  .modal-content,
  #modeSelector {
    background-color: var(--card-bg);
  }
  button,
  .navigation button,
  .review-map-btn,
  #darkModeToggle {
    background-color: var(--btn-bg);
    color: var(--btn-text);
  }
  .filter-section {
    background-color: var(--filter-bg);
  }
</style>

  <link rel="stylesheet" type="text/css" href="/quizStyle.css">
</head>
<body>
  <div class="app-container">
  <!-- Dark Mode Toggle (put in header or modeSelector) -->
<button id="darkModeToggle" style="
  position: absolute;
  top: 12px;
  right: 16px;
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: black;
">🌙 Dark Mode</button>

<!-- ⏱️ Timer Wrapper -->
<div id="timerWrapper">
  <button class="timer-toggle" onclick="toggleTimerBox()">⏱️ Timer</button>

  <div id="timerBox">
    <div id="timerDisplay">00:00</div>

    <!-- Time presets -->
    <div class="timer-controls">
      <button onclick="setTimer(15)">15 min</button>
      <button onclick="setTimer(20)">20 min</button>
      <button onclick="setTimer(30)">30 min</button>
    </div>
    <div class="timer-controls">
      <button onclick="setTimer(60)">1 hr</button>
      <button onclick="setTimer(120)">2 hr</button>
    </div>

    <!-- Custom input -->
    <div class="timer-controls">
      <input type="number" id="customTimerInput" placeholder="Custom min" min="1">
      <button onclick="setCustomTimer()">Set</button>
    </div>

    <!-- Controls -->
    <div class="timer-controls">
      <button id="pauseBtn" onclick="togglePause()">⏸️</button>
      <button onclick="resetTimer()">🔄</button>
      <button onclick="stopTimer()">🛑</button>
    </div>
  </div>
</div>


  <div id="modeSelector">
  <strong>Mode:</strong><br>
  <label><input type="radio" name="mode" value="quiz" checked onchange="switchMode('quiz')"> Quiz</label>
  <label><input type="radio" name="mode" value="eval" onchange="switchMode('eval')"> Evaluation</label>
  <div id="modeNote" style="margin-top: 8px; font-size: 0.9em;"></div>
</div>

  <h1>BPSC Quiz - <%= year %></h1>


  <div class="filter-section" style="margin-bottom: 20px;">
  <button onclick="toggleFilterPanel()" id="toggleFilterBtn">Show Filters ⬇️</button>
  <div id="filterPanel" style="display: none; margin-top: 10px;">
    <strong>Filter by Category:</strong>
    <div id="tagFilters" style="margin: 10px 0;"></div>
    <label>
    <input type="checkbox" id="shuffleToggle" onchange="toggleShuffle()"> Shuffle Questions
    </label>
  </div>
</div>


<!-- Progress Indicator -->


<div id="progressContainer" style="margin-bottom:16px;">
  <div id="progressBar" style="
    width: 100%;
    background: #e9ecef;
    border-radius: 4px;
    overflow: hidden;
    height: 8px;
">
    <div id="progressFill" style="
      width: 0%;
      height: 100%;
      background: #007bff;
      transition: width 0.3s ease;
    "></div>
  </div>
  <div style="text-align:right; font-size:0.85em; color:var(--text-color); margin-top:4px;">
    <span id="progressText">0 / 0</span>
  </div>
</div>

<div id="questionContainer" class="question-box"></div>

<div class="navigation">
    <button onclick="prevQuestion()">⟵ Previous</button>
    <button onclick="nextQuestion()">Next ⟶</button>
    <button onclick="submitQuiz()" id="submitBtn">✅ Finish Test</button>
  </div>

    
<!-- Review Action Buttons Wrapper -->
<div id="reviewActions" style="margin: 30px 0; text-align: center; display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;">
  <button id="openMapBtn" class="review-map-btn">🔍 Review Map</button>

  <button id="retryIncorrectBtn" style="display: none;" onclick="retryIncorrectOnly()">
    🔁 Retry Incorrect Only
  </button>

  <button id="reviewAllBtn" 
          style="display: none; padding: 10px 16px; background: #17a2b8; color: white; border: none; border-radius: 6px; cursor: pointer;" 
          onclick="toggleReviewAll()">
    📋 Review All Responses
  </button>
</div>



<!-- 📋 Review All Responses Table (hidden by default) -->
<div id="reviewAllContainer" style="display: none; margin: 40px auto; max-width: 800px;">
  <h3 style="text-align:center;">📋 Review All Responses</h3>
  <button
    onclick="toggleReviewAll()"
    style="float: right; margin-bottom: 10px; background:#dc3545; color:white; border:none; padding:6px 12px; border-radius:5px;"
  >
    ✖ Close
  </button>
  <table id="reviewAllTable" style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="background: #007bff; color: white;">
        <th style="padding: 10px;">Q#</th>
        <th>Question</th>
        <th>Your Answer</th>
        <th>Correct Answer</th>
        <th>Result</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</div>



  <div class="summary">
    <div style="display: flex; flex-direction: column; gap: 30px; align-items: center;">
      <div style="width: 100%; max-width: 400px;">
        <canvas id="resultChart" style="display:none;"></canvas>
        <p id="accuracyText" style="display:none; text-align:center; font-weight:bold; font-size:1.1em; margin-top: 10px;"></p>

      </div>
      <div style="width: 100%; max-width: 600px;">
        <canvas id="timeChart" style="display:none;"></canvas>
      </div>
      <div style="width: 100%; max-width: 800px;">
        <canvas id="lineChart" style="display:none;"></canvas>
      </div>
    </div>
  </div>

<!-- Category Strength Chart -->
<div id="categoryChartContainer" style="width:100%; max-width:600px; margin: 40px auto; text-align:center; display: none;">
  <h3 style="color: var(--text-color);">📊 Accuracy by Category</h3>
  <canvas id="categoryChart"></canvas>
</div>


<!-- Suggestions Summary -->
<div id="suggestionSummary" style="
     display: none;
     max-width:600px; margin:20px auto;
     padding:16px; border-radius:8px;
     background-color: var(--filter-bg);
     color: var(--text-color);
     font-size:0.95em;
"></div>


<!-- Modal -->
<div id="mapModal" class="modal" style="display:none;">
  <div class="modal-content">
    <span class="close" onclick="hideMap()">&times;</span>
    <h2>Question Map — Page <span id="mapPageNum">1</span> of <span id="mapTotalPages"></span></h2>
    

 <!-- 🧭 Legend Area -->
<div id="legend" style="margin: 10px 0; font-size: 0.9em; color: #555;">
  <!-- Quiz Mode Legend -->
  <div id="legendQuiz">
    <span class="legend-item">
      <span class="legend-box" style="background:#007bff;"></span> Answered
    </span>
    <span class="legend-item">
      <span class="legend-box" style="background:#dee2e6;"></span> Unanswered
    </span>
    <span class="legend-item">
      <span class="legend-box" style="background:transparent; border:2px solid purple;"></span> Marked for Review
    </span>
  </div>

  <!-- Evaluation Mode Legend -->
  <div id="legendEval" style="display:none;">
    <span class="legend-item">
      <span class="legend-box" style="background:#007bff;"></span> Correct
    </span>
    <span class="legend-item">
      <span class="legend-box" style="background:#dc3545;"></span> Incorrect
    </span>
    <span class="legend-item">
      <span class="legend-box" style="background:#dee2e6;"></span> Unanswered
    </span>
    <span class="legend-item">
      <span class="legend-box" style="background:transparent; border:2px solid purple;"></span> Marked for Review
    </span>
  </div>
</div>




    <div id="mapGrid"></div>
    <div class="map-nav">
      <button onclick="prevMapPage()">← Prev</button>
      <button onclick="nextMapPage()">Next →</button>
    </div>
  </div>
</div>
</div>





  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  let currentMode = 'quiz';

  const year = "<%= year %>";
  let questions = [];
  let visibleQuestions = [];       // the pool we actually render
  let currentQuestionIndex = 0;
  let selectedAnswers = JSON.parse(localStorage.getItem(`answers_${year}`)) || {};

  let reviewMarks = JSON.parse(localStorage.getItem(`reviewMarks_${year}`)) || {};

  let pieChart = null;
  let barChart = null;
  let lineChart = null;


  let timeStamps = {};             // { qid: { start, duration, tag } }
  let tagTimes = {};               // { tag: seconds }
  let tagsSet = new Set();
  let activeTags = new Set();      // tags user has checked
  let shuffleEnabled = false;

  // Toggle show/hide filter panel
  function toggleFilterPanel() {
    const panel = document.getElementById("filterPanel");
    const btn   = document.getElementById("toggleFilterBtn");
    const isVis = panel.style.display === "block";
    panel.style.display = isVis ? "none" : "block";
    btn.textContent     = isVis ? "Show Filters ⬇️" : "Hide Filters ⬆️";
  }

  let incorrectQuestions = []; // will hold IDs after submission
  let categoryChart = null;

  let expandedTd = null;
  let reviewSnapshot = {};



  // Fisher–Yates shuffle
  function shuffle(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // Recompute the visibleQuestions array after filter or shuffle changes
  function recomputeVisibleQuestions() {
    const filtered = questions.filter(q => activeTags.has(q.tag));
    visibleQuestions = shuffleEnabled ? shuffle(filtered) : filtered;
    currentQuestionIndex = 0;
    renderQuestion();
  }

  // Called when user toggles shuffle checkbox
  function toggleShuffle() {
    shuffleEnabled = document.getElementById("shuffleToggle").checked;
    recomputeVisibleQuestions();
  }


  // Dark mode setup
const darkToggle = document.getElementById('darkModeToggle');

// Apply saved preference on load
const savedDark = localStorage.getItem('darkMode') === 'true';
if (savedDark) document.body.classList.add('dark-mode');
updateDarkButton();

// Toggle handler
darkToggle.onclick = () => {
  document.body.classList.toggle('dark-mode');
  const isDark = document.body.classList.contains('dark-mode');
  localStorage.setItem('darkMode', isDark);
  updateDarkButton();
};

function updateDarkButton() {
  const isDark = document.body.classList.contains('dark-mode');
  darkToggle.innerText = isDark ? '☀️ Light Mode' : '🌙 Dark Mode';
}


function getChartColors() {
  const isDark = document.body.classList.contains('dark-mode');
  return {
    fontColor: isDark ? '#e8e6e3' : '#212529',
    gridColor: isDark ? '#444' : '#ccc',
    bgColor: isDark ? '#2e2e2e' : '#fff'
  };
}


  // Fetch questions and initialize
  async function loadQuestions() {
    const res = await fetch(`/api/questions/${year}`);
    questions = await res.json();
    questions.forEach(q => tagsSet.add(q.tag));
    tagsSet.forEach(tag => activeTags.add(tag));  // enable all by default
    renderFilters();
    // initialize shuffle flag from checkbox (should be unchecked by default)
    shuffleEnabled = document.getElementById("shuffleToggle").checked;
    recomputeVisibleQuestions();
  }

  // Render the tag checkboxes & shuffle toggle
  function renderFilters() {
    const tagDiv = document.getElementById("tagFilters");
    tagDiv.innerHTML = "";
    tagsSet.forEach(tag => {
      const id = `tag_${tag}`;
      tagDiv.innerHTML += `
        <label style="margin-right: 12px;">
          <input type="checkbox" id="${id}" checked onchange="toggleTag('${tag}')"> ${tag}
        </label>
      `;
    });
  }

  // Called when a tag checkbox is toggled
  function toggleTag(tag) {
    if (activeTags.has(tag)) activeTags.delete(tag);
    else activeTags.add(tag);
    recomputeVisibleQuestions();
  }

  // Timing helpers
  function startTimerForQuestion(qid, tag) {
    const now = Date.now();
    if (!timeStamps[qid]) timeStamps[qid] = { start: now, duration: 0, tag };
    else timeStamps[qid].start = now;
  }
  
  
  function stopTimerForQuestion(qid) {
    const now = Date.now();
    const rec = timeStamps[qid];
    if (rec && rec.start) {
      const diff = (now - rec.start) / 1000;
      rec.duration += diff;
      tagTimes[rec.tag] = (tagTimes[rec.tag] || 0) + diff;
    }
  }

  // Display the current question
function renderQuestion() {
  const container = document.getElementById("questionContainer");

  if (!visibleQuestions.length) {
    container.innerHTML = "<em>No questions match selected tags.</em>";
    return;
  }
  if (currentQuestionIndex >= visibleQuestions.length) currentQuestionIndex = 0;
  const q = visibleQuestions[currentQuestionIndex];

  // Stop previous timer, start new
  if (currentQuestionIndex > 0) {
    stopTimerForQuestion(visibleQuestions[currentQuestionIndex - 1].id);
  }
  startTimerForQuestion(q.id, q.tag);

  const sel = selectedAnswers[q.id] || "";

  // Render question + options + review checkbox
  container.innerHTML = `
    <div id="q${q.id}">
      <strong>Q${q.id}: ${q.question}</strong>
      <div class="options">
        ${q.options.map((opt, i) => `
          <label>
            <input type="radio" name="q${q.id}" value="${'ABCD'[i]}"
              ${sel === 'ABCD'[i] ? 'checked' : ''}
              onchange="markAnswer(${q.id}, '${'ABCD'[i]}')">
            ${'ABCD'[i]}. ${opt}
          </label>
        `).join('')}
      </div>
    </div>
    <div style="text-align:right; font-size:0.9em; margin-top:8px;">
      Question ${currentQuestionIndex + 1} of ${visibleQuestions.length}
      <span style="font-style:italic; color:#666;">(${q.tag})</span>
    </div>
    <div style="margin-top:8px;">
      <label>
        <input type="checkbox" onchange="toggleReviewMark(${q.id})" ${reviewMarks[q.id] ? 'checked' : ''}>
        Mark for Review
      </label>
    </div>
  `;

  // ONLY class‑based feedback—remove inline‑styles entirely
  if (currentMode === 'eval' && sel) {
    const radios = document.querySelectorAll(`input[name="q${q.id}"]`);
    radios.forEach(radio => {
      const label = radio.parentElement;
      label.classList.remove('correct','incorrect');
      if (radio.value === q.answer) {
        label.classList.add('correct');
      }
      if (radio.value === sel && sel !== q.answer) {
        label.classList.add('incorrect');
      }
    });
  }
    updateProgress();
}

  // Save answer selection
 function markAnswer(id, opt) {
  if (currentMode === 'quiz') {
    selectedAnswers[id] = opt;
    localStorage.setItem(`answers_${year}`, JSON.stringify(selectedAnswers));
  } else if (currentMode === 'eval') {
    selectedAnswers[id] = opt; // store it only in memory
    renderQuestion(); // re-render to apply feedback
  }
}


  // Navigation
  function nextQuestion() {
    if (currentQuestionIndex < visibleQuestions.length - 1) {
      currentQuestionIndex++;
      renderQuestion();
    }
  }
  function prevQuestion() {
    if (currentQuestionIndex > 0) {
      currentQuestionIndex--;
      renderQuestion();
    }
  }

  // On Finish Test
function submitQuiz() {

  //clock pause 
paused = true; 

  // 🆕 Start by wiping the old review and expanded state
  reviewSnapshot = {};
  expandedTd     = null;

  stopTimerForQuestion(visibleQuestions[currentQuestionIndex]?.id);

  let correct = 0, incorrect = 0, unattempted = 0;
  incorrectQuestions = [];

  visibleQuestions.forEach(q => {
    const sel = selectedAnswers[q.id];
    if (!sel) {
      unattempted++;
    } else if (sel === q.answer) {
      correct++;
    } else {
      incorrect++;
      incorrectQuestions.push(q.id);
    }
  });

  renderPieChart(correct, incorrect, unattempted);
  renderBarChart();
  renderLineChart();

  renderCategoryChart();


  const total = correct + incorrect;
  const acc = total > 0 ? ((correct / total) * 100).toFixed(1) : "0.0";
  const e = document.getElementById("accuracyText");
  e.innerText = `🎯 Accuracy: ${acc}%`;
  e.style.display = "block";

// Show the Review All button once quiz is submitted
document.getElementById('reviewAllContainer').style.display = 'none';
document.getElementById('reviewAllBtn').style.display = 'inline-block';


// Show buttons
  document.getElementById('retryIncorrectBtn').style.display =
    incorrectQuestions.length ? 'inline-block' : 'none';
 // ⚡ Show & reset Review‑All button
const reviewBtn = document.getElementById("reviewAllBtn");
reviewBtn.style.display = "inline-block";
reviewBtn.innerText    = "📋 Review All Responses";

// Hide the table container (in case it was open)
document.getElementById("reviewAllContainer").style.display = "none";

      // 1️⃣ Snapshot current answers for review
    reviewSnapshot = { ...selectedAnswers };

  // Clear answers (after charts)
  localStorage.removeItem(`answers_${year}`);
  selectedAnswers = {};

  

}

function switchMode(mode) {
  if (currentMode === mode) return;

  // 🔄 Reset review snapshot & any expanded cell
  reviewSnapshot = {};
  expandedTd = null;

  // 1. Update mode & reset position
  currentMode = mode;
  currentQuestionIndex = 0;

  // 2. Hide all result sections & summary areas
  [
    "resultChart",
    "timeChart",
    "lineChart",
    "categoryChart",      // hide category accuracy chart
    "accuracyText",
    "reviewContainer"
  ].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.style.display = "none";
  });

  // Also hide the suggestion summary and retry button
  const summary = document.getElementById("suggestionSummary");
  if (summary) summary.style.display = "none";

  const retryBtn = document.getElementById("retryIncorrectBtn");
  if (retryBtn) retryBtn.style.display = "none";

  document.getElementById("categoryChartContainer").style.display = "none";

// Hide & reset the Review‑All UI
  const reviewBtn = document.getElementById("reviewAllBtn");
  const reviewContainer = document.getElementById("reviewAllContainer");
  reviewBtn.style.display    = "none";
  reviewBtn.innerText         = "📋 Review All Responses";
  reviewContainer.style.display = "none";


  // 3. Clear all stored answers & review marks
  localStorage.removeItem(`answers_${year}`);
  localStorage.removeItem(`reviewMarks_${year}`);
  selectedAnswers = {};
  reviewMarks = {};

  // 4. Update Finish button label & mode explanation
  document.getElementById('submitBtn').innerText =
    mode === 'quiz' ? '✅ Finish Test' : '📊 Finish Evaluation';
  document.getElementById('modeNote').innerText =
    mode === 'quiz'
      ? 'In Quiz Mode: your answers are saved and reviewed at the end.'
      : 'In Evaluation Mode: you get instant feedback per question.';

  // 5. Toggle which legend is visible
  const quizLegend = document.getElementById("legendQuiz");
  const evalLegend = document.getElementById("legendEval");
  if (quizLegend && evalLegend) {
    quizLegend.style.display = mode === 'quiz' ? 'block' : 'none';
    evalLegend.style.display = mode === 'eval' ? 'block' : 'none';
  }

  // 6. Rebuild & render the first question for the new mode
  recomputeVisibleQuestions();
}

  // Pie Chart
// Pie Chart
function renderPieChart(correct, incorrect, unanswered) {
  const { fontColor } = getChartColors();
  document.getElementById("resultChart").style.display = "block";
  const ctx = document.getElementById("resultChart").getContext("2d");
  if (pieChart) pieChart.destroy();
  pieChart = new Chart(ctx, {
    type: "pie",
    data: {
      labels: ["Correct", "Incorrect", "Unanswered"],
      datasets: [{
        data: [correct, incorrect, unanswered],
        backgroundColor: ["#28a745", "#dc3545", "#ffc107"]
      }]
    },
    options: {
      plugins: {
        legend: {
          position: 'bottom',
          labels: { color: fontColor }
        },
        title: {
          display: true,
          text: "Quiz Results",
          color: fontColor
        }
      }
    }
  });
}

// Bar Chart (time per category)
function renderBarChart() {
  const { fontColor, gridColor } = getChartColors();
  document.getElementById("timeChart").style.display = "block";
  const labels = Object.keys(tagTimes);
  const data   = labels.map(tag => Math.round(tagTimes[tag] || 0));
  const ctx    = document.getElementById("timeChart").getContext("2d");
  if (barChart) barChart.destroy();
  barChart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels,
      datasets: [{
        label: "Time Spent (s)",
        data,
        backgroundColor: "#007bff"
      }]
    },
    options: {
      indexAxis: 'y',
      plugins: {
        title: { display: true, text: "Time Spent by Category", color: fontColor },
        legend: { display: false }
      },
      scales: {
        x: {
          beginAtZero: true,
          grid: { color: gridColor },
          ticks: { color: fontColor }
        },
        y: {
          grid: { color: gridColor },
          ticks: { color: fontColor }
        }
      }
    }
  });
}

// Line Chart (time per question)
function renderLineChart() {
  const { fontColor, gridColor } = getChartColors();
  document.getElementById("lineChart").style.display = "block";
  const labels = visibleQuestions.map(q => `Q${q.id} (${q.tag})`);
  const data   = visibleQuestions.map(q => Math.round(timeStamps[q.id]?.duration || 0));
  const ctx    = document.getElementById("lineChart").getContext("2d");
  if (lineChart) lineChart.destroy();
  lineChart = new Chart(ctx, {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: "Time per Question (s)",
        data,
        fill: false,
        borderColor: "#17a2b8",
        tension: 0.3,
        pointBackgroundColor: "#17a2b8"
      }]
    },
    options: {
      responsive: true,
      plugins: {
        title:  { display: true, text: "Time Taken Per Question", color: fontColor },
        legend: { display: false }
      },
      scales: {
        x: {
          title: { display: true, text: "Questions", color: fontColor },
          ticks: { color: fontColor },
          grid: { color: gridColor }
        },
        y: {
          beginAtZero: true,
          title: { display: true, text: "Time (s)", color: fontColor },
          ticks: { color: fontColor },
          grid: { color: gridColor }
        }
      }
    }
  });
}


function renderCategoryChart() {

  // 1. Tally per‑tag correct vs attempted & total time
  const tally = {};
  visibleQuestions.forEach(q => {
    const tag = q.tag;
    if (!tally[tag]) tally[tag] = { correct: 0, attempted: 0, totalTime: 0 };
    const sel = selectedAnswers[q.id];
    if (sel) {
      tally[tag].attempted++;
      if (sel === q.answer) tally[tag].correct++;
      tally[tag].totalTime += (timeStamps[q.id]?.duration || 0);
    }
  });

  // 2. Build arrays *only for tags with at least one attempt*
  const tags    = [];
  const accs    = [];
  const avgTime = [];
  for (const [tag, data] of Object.entries(tally)) {
    if (data.attempted > 0) {
      tags.push(tag);
      // store as numbers, not strings
      accs.push(data.correct / data.attempted * 100);
      avgTime.push(data.totalTime / data.attempted);
    }
  }

   // Show or hide the category chart canvas and suggestion summary
  document.getElementById("categoryChartContainer").style.display = tags.length ? "block" : "none";
  document.getElementById("suggestionSummary").style.display =
    tags.length ? "block" : "none";

  // 3. Render the bar chart
  const { fontColor, gridColor } = getChartColors();
  const ctx = document.getElementById("categoryChart").getContext("2d");
  if (categoryChart) categoryChart.destroy();
  document.getElementById("categoryChart").style.display = tags.length ? "block" : "none";
  categoryChart = new Chart(ctx, {
    type: 'bar',
    data: { labels: tags, datasets: [{ label: '% Accuracy', data: accs, backgroundColor: '#17a2b8' }] },
    options: {
      plugins: {
        title: { display: true, text: "Accuracy by Category", color: fontColor },
        legend: { display: false }
      },
      scales: {
        x: { ticks: { color: fontColor }, grid: { color: gridColor } },
        y: {
          beginAtZero: true, max: 100,
          ticks: { color: fontColor, callback: v => v + '%' },
          grid: { color: gridColor }
        }
      }
    }
  });

  // 4. Generate user suggestions
  generateSuggestions(tags, accs, avgTime);
}

function generateSuggestions(tags, accs, avgTime) {
  if (!tags.length) {
    document.getElementById("suggestionSummary").innerHTML =
      "<p>No attempted questions to analyze.</p>";
    return;
  }

  // Find max/min accuracies
  const maxAcc = Math.max(...accs);
  const minAcc = Math.min(...accs);

  // Best and weakest topics
  const bestTags   = tags.filter((_,i) => accs[i] === maxAcc);
  const weakestTag = tags[accs.indexOf(minAcc)];

  // Slowest by avgTime
  const maxTime   = Math.max(...avgTime);
  const slowestTag = tags[avgTime.indexOf(maxTime)];

  // Overall accuracy
  let totalCorrect = 0, totalAttempted = 0;
  visibleQuestions.forEach(q => {
    const sel = selectedAnswers[q.id];
    if (sel) {
      totalAttempted++;
      if (sel === q.answer) totalCorrect++;
    }
  });
  const overallAcc = totalAttempted
    ? (totalCorrect / totalAttempted * 100).toFixed(1)
    : "0.0";

  // Build summary
  const lines = [];
  lines.push(
    `✅ You did best in ${bestTags.join(', ')} with ${maxAcc.toFixed(1)}% accuracy.`
  );
  if (bestTags.length > 1) {
    lines.push(`(Tie between: ${bestTags.join(', ')})`);
  }
  lines.push(
    `⚠️ Your weakest topic is ${weakestTag} at ${minAcc.toFixed(1)}% accuracy.`
  );
  lines.push(
    `⏱️ You took the longest per question in ${slowestTag} (avg ${Math.round(maxTime)}s).`
  );
  lines.push(`🎯 Overall accuracy: ${overallAcc}%.`);
  lines.push(
    `💡 Focus on improving in <strong>${weakestTag}</strong> and speed drills for <strong>${slowestTag}</strong>.`
  );

  document.getElementById("suggestionSummary").innerHTML =
    lines.map(l => `<p>${l}</p>`).join('');
}

function retryIncorrectOnly() {
  if (!incorrectQuestions.length) return;

  // Reset everything for a new quiz
  currentMode = 'quiz';
  currentQuestionIndex = 0;
  selectedAnswers = {};
  reviewMarks = {};
  timeStamps = {};
  tagTimes = {};

  // Filter questions to only those marked incorrect
  visibleQuestions = questions.filter(q => incorrectQuestions.includes(q.id));
  incorrectQuestions = []; // reset this too

  // Hide charts and retry button
  document.getElementById("resultChart").style.display = "none";
  document.getElementById("timeChart").style.display = "none";
  document.getElementById("lineChart").style.display = "none";
  document.getElementById("accuracyText").style.display = "none";
  document.getElementById("retryIncorrectBtn").style.display = "none";

  // Update mode text
  document.getElementById('modeNote').innerText =
    'Retry Mode: Reattempt your incorrect questions.';
  document.getElementById('submitBtn').innerText = '✅ Finish Retry';

  // Show appropriate legend
  const quizLegend = document.getElementById("legendQuiz");
  const evalLegend = document.getElementById("legendEval");
  if (quizLegend && evalLegend) {
    quizLegend.style.display = 'block';
    evalLegend.style.display = 'none';
  }

  // Show them the first question again
  renderQuestion();
}

function toggleReviewAll() {
  const container = document.getElementById('reviewAllContainer');
  if (container.style.display === 'none') {
    renderReviewAll();     // build rows
    container.style.display = 'block';
    document.getElementById('reviewAllBtn').innerText = '❌ Hide Responses';
  } else {
    container.style.display = 'none';
    document.getElementById('reviewAllBtn').innerText = '📋 Review All Responses';
  }
}

function renderReviewAll() {
  const tbody = document.querySelector("#reviewAllTable tbody");
  tbody.innerHTML = "";

  visibleQuestions.forEach((q, idx) => {
    // ✅ Pull from the snapshot, not live selectedAnswers
    const yourAnswer = reviewSnapshot[q.id];
    const isUnattempted = yourAnswer === undefined;
    const isCorrect = yourAnswer === q.answer;

    const row = document.createElement("tr");
    if (idx % 2 === 1) row.style.background = "rgba(0,0,0,0.03)";

    // Q# cell
    const qNoTd = document.createElement("td");
    qNoTd.style.padding = "8px";
    qNoTd.textContent = q.id;

    // Question cell (truncated/expandable)
    const questionTd = document.createElement("td");
    questionTd.style.padding = "8px";
    questionTd.className = "review-question-cell";
    questionTd.textContent = q.question;

    // Your answer cell
    const yourTd = document.createElement("td");
    yourTd.style.padding = "8px";
    yourTd.style.textAlign = "center";
    yourTd.innerHTML = isUnattempted ? "<em>Unattempted</em>" : yourAnswer;

    // Correct answer cell
    const corrTd = document.createElement("td");
    corrTd.style.padding = "8px";
    corrTd.style.textAlign = "center";
    corrTd.textContent = q.answer;

    // Result cell
    const statusTd = document.createElement("td");
    statusTd.style.padding = "8px";
    statusTd.style.textAlign = "center";
    statusTd.textContent = isUnattempted ? "⏺" : (isCorrect ? "✅" : "❌");

    // Build the row
    row.append(qNoTd, questionTd, yourTd, corrTd, statusTd);
    tbody.appendChild(row);

    // Click to toggle truncated/expanded question
    questionTd.onclick = () => {
      if (expandedTd === questionTd) {
        questionTd.classList.remove("expanded");
        expandedTd = null;
      } else {
        if (expandedTd) expandedTd.classList.remove("expanded");
        questionTd.classList.add("expanded");
        expandedTd = questionTd;
      }
    };
  });
}

function toggleReviewAll() {
  const container = document.getElementById("reviewAllContainer");
  if (container.style.display === "none") {
    renderReviewAll();     // build the rows
    container.style.display = "block";
    document.getElementById('reviewAllBtn').innerText = '❌ Hide Responses';
  } else {
    container.style.display = "none";
    document.getElementById('reviewAllBtn').innerText = '📋 Review All Responses';
  }
}


