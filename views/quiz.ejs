let mapPage = 1;
const pageSize = 30;

document.getElementById('openMapBtn').onclick = showMap;

function updateProgress() {
  const total = visibleQuestions.length;
  const current = currentQuestionIndex + 1;
  const percent = total ? Math.round((current / total) * 100) : 0;
  document.getElementById('progressFill').style.width = percent + '%';
  document.getElementById('progressText').innerText = `${current} / ${total}`;
}

function showMap() {
  mapPage = 1;
  renderMap();
  document.getElementById('mapModal').style.display = 'flex';
}

function toggleReviewMark(id) {
  reviewMarks[id] = !reviewMarks[id];
  localStorage.setItem(`reviewMarks_${year}`, JSON.stringify(reviewMarks));
}

function hideMap() {
  document.getElementById('mapModal').style.display = 'none';
}
function renderMap() {
  const total = visibleQuestions.length;
  const totalPages = Math.ceil(total / pageSize);
  document.getElementById('mapTotalPages').innerText = totalPages;
  document.getElementById('mapPageNum').innerText = mapPage;

  const start = (mapPage - 1) * pageSize;
  const slice = visibleQuestions.slice(start, start + pageSize);

  const grid = document.getElementById('mapGrid');
  grid.innerHTML = '';

  slice.forEach((q, idx) => {
    const tile = document.createElement('div');
    tile.classList.add('tile');
    tile.innerText = q.id;

    const userAns = selectedAnswers[q.id];
    const correctAns = q.answer;

    // Color Logic
    if (reviewMarks[q.id]) {
      tile.classList.add('marked');
    } else if (!userAns) {
      tile.classList.add('unanswered');
    } else if (currentMode === 'eval' && userAns !== correctAns) {
      tile.classList.add('incorrect');
    } else {
      tile.classList.add('answered');
    }

    // Tooltip
    tile.title = `Q${q.id} – ${
      reviewMarks[q.id] ? 'Marked for Review' :
      !userAns ? 'Unanswered' :
      currentMode === 'eval' && userAns !== correctAns ? 'Incorrect' : 'Answered'
    }`;

    // Click-to-jump
    tile.onclick = () => {
      currentQuestionIndex = visibleQuestions.findIndex(x => x.id === q.id);
      renderQuestion();
      hideMap();
    };

    grid.appendChild(tile);
  });
}

function nextMapPage() {
  const totalPages = Math.ceil(visibleQuestions.length / pageSize);
  if (mapPage < totalPages) { mapPage++; renderMap(); }
}
function prevMapPage() {
  if (mapPage > 1) { mapPage--; renderMap(); }
}



//clock
let elapsedSeconds = 0;
let timerInterval = null;
let paused = false;
let countdownTarget = null;

function formatTime(sec) {
  const m = Math.floor(sec / 60).toString().padStart(2, '0');
  const s = (sec % 60).toString().padStart(2, '0');
  return `${m}:${s}`;
}

function updateTimerDisplay() {
  const display = document.getElementById("timerDisplay");
  const remaining = countdownTarget !== null
    ? Math.max(0, countdownTarget - elapsedSeconds)
    : elapsedSeconds;

  display.innerText = formatTime(remaining);

  if (countdownTarget !== null && remaining === 0) {
    stopTimer();
    display.innerText = "⏰ Done!";
  }
}

function startTimer() {
  if (timerInterval) clearInterval(timerInterval);
  paused = false;
  updatePauseBtnIcon();
  timerInterval = setInterval(() => {
    if (!paused) {
      elapsedSeconds++;
      updateTimerDisplay();
    }
  }, 1000);
}

function togglePause() {
  paused = !paused;
  updatePauseBtnIcon();
}

function updatePauseBtnIcon() {
  document.getElementById("pauseBtn").innerText = paused ? "▶️" : "⏸️";
}

function resetTimer() {
  clearInterval(timerInterval);
  elapsedSeconds = 0;
  countdownTarget = null;
  paused = false;
  updatePauseBtnIcon();
  updateTimerDisplay();
  startTimer();
}

function stopTimer() {
  clearInterval(timerInterval);
  elapsedSeconds = 0;
  countdownTarget = null;
  paused = false;
  updatePauseBtnIcon();
  document.getElementById("timerDisplay").innerText = "--:--";
}

function setTimer(minutes) {
  elapsedSeconds = 0;
  countdownTarget = minutes * 60;
  paused = false;
  updatePauseBtnIcon();
  updateTimerDisplay();
  startTimer();
}

function setCustomTimer() {
  const mins = parseInt(document.getElementById("customTimerInput").value);
  if (!isNaN(mins) && mins > 0) {
    setTimer(mins);
  }
}

function toggleTimerBox() {
  const box = document.getElementById("timerBox");
  box.style.display = box.style.display === "none" ? "block" : "none";
}

window.addEventListener("load", () => {
  resetTimer();
});



// 1) Initial width
  const initialWidth = window.innerWidth;
  const timerWrapper = document.getElementById("timerWrapper");

  // 2) Hide/show based on current size
  function checkWindowSize() {
    if (window.innerWidth <= initialWidth * 0.8) {
      timerWrapper.style.display = "none";
    } else {
      timerWrapper.style.display = "block";
    }
  }

  // 3) Listen on resize & load
  window.addEventListener("resize", checkWindowSize);
  window.addEventListener("load", checkWindowSize);

  //clock disapper wwhen scroll
window.addEventListener("scroll", () => {
  const reviewActions = document.getElementById("reviewActions");
  const timerWrapper = document.getElementById("timerWrapper");

  if (!reviewActions || !timerWrapper) return;

  const rect = reviewActions.getBoundingClientRect();
  const isBelowViewport = rect.top < 0;

  // Hide timer if review section is scrolled out of view
  timerWrapper.style.display = isBelowViewport ? "none" : "block";
});



